# Required: seller ID and API key from the GGsel seller dashboard.
GGSEL_SELLER_ID=
GGSEL_API_KEY=

# Required: Telegram bot token, forum group ID and operator user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Comma-separated personal user IDs. Group admin rights alone are insufficient.
TELEGRAM_ALLOWED_USER_IDS=

GGSEL_BASE_URL=https://seller.ggsel.com/api_sellers/api
POLL_INTERVAL=15
CHAT_CHECK_INTERVAL=40
GGSEL_CONNECT_TIMEOUT=5
GGSEL_READ_TIMEOUT=30

# Optional HTTP or SOCKS5 proxy; omit for a direct connection.
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# Native Python paths; Docker Compose overrides these with /data paths.
DATABASE_PATH=data/ggsel_bot.db
AUTORESPONDER_CONFIG_PATH=data/autoresponder.json
PLUGINS_DIR=data/plugins

# Manual Docker updates are recommended. No downloads or code replacement by default.
AUTO_UPDATE=false
UPDATE_VERSION=
UPDATE_SHA256=
